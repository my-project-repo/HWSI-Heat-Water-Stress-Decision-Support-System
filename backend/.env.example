# Project Bhumi (HWSI) - Backend Environment Configuration
# Copy this file to .env and provide your credentials

# AWS Configuration (Region: Asia Pacific Sydney)
AWS_DEFAULT_REGION=ap-southeast-2
AWS_REGION=ap-southeast-2

# AWS IAM Credentials (Least privilege: Bedrock InvokeModel + S3 read/write)
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Amazon Bedrock Configuration
# Model ID: apac.anthropic.claude-3-5-sonnet-20241022-v2:0
AWS_BEARER_TOKEN_BEDROCK=your_bedrock_bearer_token_here

# Amazon S3 Data Lake Bucket
S3_BUCKET_NAME=bhumi-data-lake-pilot
